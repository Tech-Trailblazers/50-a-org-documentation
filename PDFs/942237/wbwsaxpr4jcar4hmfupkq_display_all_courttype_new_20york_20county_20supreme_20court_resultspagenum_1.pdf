      <span style="width:59em;font-weight:bold"><span class="captionText">Deandre Johnson - v. - The City of New York et al</span></span>
    </span>
    <span class="row"><span>Case Type:&nbsp;<strong>Tort</strong></span></span><br />
		<span class="row"><span>Case Status:&nbsp;<strong>Pre-RJI</strong></span></span><br />
    <span class="row"><span>eFiling Status:&nbsp;    <strong><a title="One or more parties have not recorded their participation in e-filing. E-filing parties must serve documents on non-participating parties in hard copy and e-file proof of such service [see Uniform Rule &sect; 202.5-b(b)(2) and 202.5-bb(e)(5)]." style="cursor:help" style="pointer-events:none;">Partial Participation Recorded</a></strong>
</span></span><br/>
  </div>



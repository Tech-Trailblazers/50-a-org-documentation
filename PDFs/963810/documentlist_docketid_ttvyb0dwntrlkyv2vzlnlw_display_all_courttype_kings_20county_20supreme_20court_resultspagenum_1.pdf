    function showHide(id) {
      if (document.getElementById(id)) {
        if (document.getElementById('clerkMessage-show').style.display != 'none') {
          document.getElementById('clerkMessage-show').style.display = 'none';
          document.getElementById('clerkMessage').style.display = 'block';
        }
        else {
          document.getElementById('clerkMessage-show').style.display = 'inline';
          document.getElementById('clerkMessage').style.display = 'none';
        }
      }
    }
